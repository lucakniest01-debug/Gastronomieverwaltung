<Window x:Class="KasseOhneDB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kasse (ohne Datenbank)" Height="450" Width="800"
        Background="Chocolate">
    
    <Window.Resources>
        <!-- Abgerundete Ecken für alle TextBoxen und Buttons -->
        
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="5,4"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="8"/>
                </Style>
            </Style.Resources>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Überschrift über beide Spalten -->
        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Kasse"
                   FontSize="36" FontWeight="Bold"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="Black"/>

        <!-- Linke Seite: Eingaben -->
        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,30,0">
            <Label Content="Artikel:"/>
            <ComboBox x:Name="cmbArtikel" Height="30" FontSize="14"
                      IsEditable="True" TextSearch.TextPath="Name"
                      Background="LightGray">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Name, Mode=OneWay}"/>
                            <Run Text=" – " Foreground="Gray"/>
                            <Run Text="{Binding Preis, Mode=OneWay, StringFormat={}{0:C}, ConverterCulture=de-DE}"
                                 Foreground="Black"
                                 />
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Label Content="Anzahl:" Margin="0,10,0,0"/>
            <TextBox x:Name="txtAnzahl"/>

            <Button x:Name="btnHinzufuegen" Margin="0,10,0,0" Height="50"
                    Click="BtnHinzufuegen_Click">
                <TextBlock Text="Zur Bestellung hinzufügen"
                           TextWrapping="Wrap" TextAlignment="Center"
                           FontFamily="Arial"/>
            </Button>
            <Button x:Name="btnLoeschen" Margin="0,10,0,0" Height="50" Click="BtnLoeschen_Click">
                <TextBlock Text="Bestellung löschen" TextWrapping="Wrap" TextAlignment="Center"
                               FontFamily="Arial"/>
            </Button>
            <Button x:Name="btnAbschliessen" Margin="0,10,0,0" Height="50" Click="BtnAbschliessen_Click">
                <TextBlock TextAlignment="Center" TextWrapping="Wrap" FontFamily="Arial">Abschließen</TextBlock>
            </Button>
            
        </StackPanel>

        <!-- Rechte Seite: Bestellübersicht -->
        <DockPanel Grid.Row="1" Grid.Column="1">
            <Label DockPanel.Dock="Top" Content="Bestellübersicht:"/>
            <!-- Gesamtpreis unten rechts -->
            <TextBlock x:Name="txtGesamt" DockPanel.Dock="Bottom"
                       HorizontalAlignment="Right" Margin="0,10,5,0"
                       FontSize="20" FontWeight="Bold" Text="Gesamt: 0,00 €"/>
            <Border BorderBrush="Black" BorderThickness="1.5" CornerRadius="12" Padding="5">
                <ListBox x:Name="lstBestellung" BorderThickness="0" FontSize="14"
                         HorizontalContentAlignment="Stretch"
                         Background="LightGray">
                    <ListBox.ItemTemplate >
                        <DataTemplate>
                            <Grid >
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" FontSize="20" Text="{Binding Text}"/>
                                <TextBlock Grid.Column="1" FontSize="20" Text="{Binding PreisText}" FontWeight="SemiBold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </DockPanel>
    </Grid>
</Window>
