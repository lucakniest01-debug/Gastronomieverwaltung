<Window x:Class="Lagerverwaltung.ArtikelBestellenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artikel bestellen" Height="420" Width="620"
        MinHeight="350" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        Background="Chocolate">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,15,0">
            <Label Content="Artikel:" FontSize="14"/>
            <ComboBox x:Name="cmbArtikel" FontSize="14" Padding="4"
                      DisplayMemberPath="Name"
                      SelectionChanged="CmbArtikel_SelectionChanged"/>
            <TextBlock x:Name="txtInfo" FontSize="12" Margin="5,4,0,0" TextWrapping="Wrap"/>

            <Label Content="Menge:" FontSize="14" Margin="0,8,0,0"/>
            <TextBox x:Name="txtMenge" FontSize="14" Padding="4"/>

            <Button Content="Zur Bestellung hinzufügen" FontSize="14" Padding="10,6"
                    Margin="0,15,0,0" Click="BtnHinzufuegen_Click"/>
            <Button Content="Position entfernen" FontSize="14" Padding="10,6"
                    Margin="0,10,0,0" Click="BtnEntfernen_Click"/>
        </StackPanel>

        <DockPanel Grid.Column="1">
            <Label DockPanel.Dock="Top" Content="Bestellung:" FontSize="14"/>
            <Border BorderBrush="Black" BorderThickness="1.5" CornerRadius="8"
                    Background="White" Padding="5">
                <ListBox x:Name="lstBestellung" FontSize="14" BorderThickness="0"/>
            </Border>
        </DockPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Abbrechen" FontSize="14" Padding="12,5" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Bestellung abschließen" FontSize="14" Padding="12,5"
                    Click="BtnAbschliessen_Click"/>
        </StackPanel>
    </Grid>
</Window>
