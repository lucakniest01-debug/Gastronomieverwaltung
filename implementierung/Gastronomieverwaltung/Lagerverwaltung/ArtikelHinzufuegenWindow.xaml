<Window x:Class="Lagerverwaltung.ArtikelHinzufuegenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Artikel hinzufügen" SizeToContent="Height" Width="360"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="Chocolate">
    <StackPanel Margin="15">
        <Label Content="Artikelname:" FontSize="14"/>
        <TextBox x:Name="txtName" FontSize="14" Padding="4"/>

        <Label Content="Menge:" FontSize="14" Margin="0,8,0,0"/>
        <TextBox x:Name="txtMenge" FontSize="14" Padding="4"/>

        <Label Content="Mindestbestand (nur bei neuem Artikel):" FontSize="14" Margin="0,8,0,0"/>
        <TextBox x:Name="txtMinimum" FontSize="14" Padding="4"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Abbrechen" FontSize="14" Padding="12,5" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="Speichern" FontSize="14" Padding="12,5" IsDefault="True"
                    Click="BtnSpeichern_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
